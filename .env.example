# MariaDB Configuration
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=your_username
MARIADB_PASSWORD=your_password
MARIADB_DATABASE=your_database

# API Configuration
API_PORT=3001

# Comma-separated CORS origins (optional; defaults include ozkr.net, oz-ragnarok.web.app and localhost)
# CORS_ORIGINS=https://ozkr.net,https://www.ozkr.net,https://ozro-api.ozkr.net,https://oz-ragnarok.web.app

# Game DB tables (optional; auto-detect mob_db_re/item_db_re or fallback to mob_db/item_db)
# MOB_TABLE=mob_db_re
# MOB2_TABLE=mob_db2_re
# ITEM_TABLE=item_db_re
# ITEM2_TABLE=item_db2_re
# MOB2_TABLE=none   # skip custom mob overlay table